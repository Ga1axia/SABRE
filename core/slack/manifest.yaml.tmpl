display_information:
  name: SABRE
  description: Autonomous company agent. Reports to one operator.
  background_color: "#1a1a1a"
features:
  app_home:
    messages_tab_enabled: true
    messages_tab_read_only_enabled: false
  bot_user:
    display_name: SABRE
    always_online: true
oauth_config:
  scopes:
    bot:
      - app_mentions:read
      - channels:history
      - channels:join
      - channels:manage
      - channels:read
      - chat:write
      - commands
      - groups:history
      - groups:read
      - reactions:read
      - reactions:write
      - users:read
settings:
  event_subscriptions:
    bot_events:
      - message.channels
      - message.groups
      - app_mention
      - reaction_added
      - reaction_removed
  interactivity:
    is_enabled: true
  org_deploy_enabled: false
  socket_mode_enabled: true
  token_rotation_enabled: false
slash_commands:
  - command: /sabre
    description: SABRE status
    should_escape: false
  - command: /kill
    description: Engage the kill switch
    should_escape: false
  - command: /status
    description: One-line company status
    should_escape: false
  - command: /approve
    description: Approve a held intent
    should_escape: false
  - command: /veto
    description: Veto a held intent
    should_escape: false
